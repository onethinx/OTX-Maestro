{
  "name": "otx-maestro",
  "displayName": "OTX Maestro",
  "description": "A VS Code extension to support the Onethinx Core Module.",
  "version": "1.1.2",
  "publisher": "Onethinx",
  "repository": {
    "type": "git",
    "url": "https://github.com/onethinx/OTX-Maestro.git"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.63.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.63.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "otx-maestro",
          "title": "OTX Maestro",
          "icon": "images/icon-sidebar.png"
        }
      ]
    },
    "views": {
      "otx-maestro": [
        {
          "type": "webview",
          "id": "otx-maestro.sidebar",
          "name": "Settings",
          "icon": "images/icon-sidebar.png"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": ".vscode/tasks.json",
        "url": "./out/tasks-schema.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "OTX Maestro Configuration",
      "properties": {
        "otx-maestro.defaultDebugger": {
          "type": "string",
          "default": "",
          "description": "Default debugger"
        },
        "otx-maestro.alwaysActivate": {
          "type": "boolean",
          "default": false,
          "description": "Always activate extension (can be helpful for showing task buttons)"
        }
      }
    },
    "commands": [
      {
        "command": "otx-maestro.showInfo",
        "title": "OTX-Maestro: Show OTX Maestro version info"
      },
      {
        "command": "otx-maestro.updateProject",
        "title": "OTX-Maestro: Update Project"
      },
      {
        "command": "otx-maestro.selProg",
        "title": "OTX-Maestro: Select Programmer"
      },
      {
        "command": "otx-maestro.clean",
        "title": "OTX-Maestro: Clean-Reconfigure"
      },
      {
        "command": "otx-maestro.build",
        "title": "OTX-Maestro: Build"
      },
      {
        "command": "otx-maestro.launch",
        "title": "OTX-Maestro: Build-and-Launch"
      },
      {
        "command": "otx-maestro.check",
        "title": "OTX-Maestro: Check OTX-18 info"
      },
      {
        "command": "otx-maestro.configureProvisioning",
        "title": "OTX-Maestro: Configure Provisioning"
      },
      {
        "command": "otx-maestro.doProvisioning",
        "title": "OTX-Maestro: Provision OTX-18"
      }
    ]
  },
  "keywords": [
    "cortex-m",
    "gdb",
    "onethinx",
    "otx-18",
    "lorawan",
    "debug",
    "embedded"
  ],
  "extensionDependencies": [
    "ms-vscode.cpptools",
    "onethinx.cortex-gdb",
    "mrmomo.meson-build"
  ],
  "dependencies": {
    "@grpc/grpc-js": "^1.13.0",
    "@grpc/proto-loader": "^0.7.13"
  }
}