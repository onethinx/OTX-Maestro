{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Custom VS Code Tasks (OTX-Maestro)",
    "allOf": [
      {
        "$ref": "vscode://schemas/tasks"
      },
      {
        "properties": {
          "tasks": {
            "items": {
              "properties": {
                "options": {
                  "properties": {
                    "statusbar": {
                      "description": "OTX-Maestro: Settings for a status bar item",
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "description": "OTX-Maestro: Label to display in the status bar"
                        },
                        "color": {
                          "type": "string",
                          "description": "OTX-Maestro: Color of the status bar item"
                        },
                        "detail": {
                          "type": "string",
                          "description": "OTX-Maestro: Detail description for the status bar item"
                        },
                        "hide": {
                          "type": "boolean",
                          "description": "OTX-Maestro: Hide status bar item"
                        },
                        "alignment": {
                          "type": "string",
                          "enum": ["left", "right"],
                          "description": "OTX-Maestro: Alignment of the status bar item"
                        },
                        "priority": {
                          "type": "integer",
                          "description": "OTX-Maestro: Priority of the status bar item, affecting its order"
                        }
                      },
                      "additionalProperties": false
                    },
                    "sidebar": {
                      "description": "OTX-Maestro: Settings for a sidebar item",
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "description": "OTX-Maestro: Label to display in the sidebar"
                        },
                        "color": {
                          "type": "string",
                          "description": "OTX-Maestro: Color of the sidebar item"
                        },
                        "detail": {
                          "type": "string",
                          "description": "OTX-Maestro: Detail description for the sidebar item"
                        },
                        "hide": {
                          "type": "boolean",
                          "description": "OTX-Maestro: Hide sidebar item"
                        },
                        "spacer": {
                          "type": "boolean",
                          "description": "OTX-Maestro: Add a spacer before the item in the sidebar"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    ]
  }
  